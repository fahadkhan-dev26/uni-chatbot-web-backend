# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Client origin (for CORS) ──────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Paste your own Atlas connection string here. Never commit real credentials.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/UniversityAIChatbot?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/UniversityAIChatbot

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_long_random_secret_here
JWT_EXPIRES_IN=7d

# ── Admin seeding (run once, then remove these) ───────────────────────────────
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=YourStrongPassword123!

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Chat answers are expensive: max questions per window per user/IP.
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=20

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_REQ=5

# Chat message attachments (multipart field "attachments"). Files are parsed in
# memory for one answer and never stored or added to the document corpus.
CHAT_ATTACHMENT_MAX_MB=10
CHAT_ATTACHMENT_MAX_FILES=3

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_MODEL_DIR=./models
EMBEDDING_BATCH_SIZE=32

# ── RAG retrieval ─────────────────────────────────────────────────────────────
RAG_TOP_K=5
# Cosine similarity floor. Relevant matches usually score 0.45–0.75; below
# ~0.35 the passages are too weak to answer from, so the fixed fallback fires.
RAG_MIN_SCORE=0.35

# ── Ollama (local LLM inference) ──────────────────────────────────────────────
# Start Ollama with: ollama serve        (Windows: it runs as a background app)
# Download a model:  ollama pull llama3.2
# List models:       ollama list
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Optional multi-modal model for student-attached images (e.g. ollama pull llava).
# Leave empty to keep image analysis disabled; attachments still work for PDFs
# and text files, and images are skipped with an explanatory notice.
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT_MS=120000
OLLAMA_MAX_TOKENS=1024
OLLAMA_TEMPERATURE=0.1
# Context window in tokens. Ollama's default (2048) silently truncates the
# prompt once 5 passages are attached, dropping the system rules. Raise this
# if you increase RAG_TOP_K; each extra 1k of context costs RAM for the KV cache.
OLLAMA_NUM_CTX=8192
